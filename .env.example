# Database Configuration (Used by Docker Compose)
POSTGRES_DB_USER=your_db_user
POSTGRES_DB_NAME=your_db_name
POSTGRES_DB_PASSWORD=your_db_password
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432

# PayPal Sandbox Developer Credentials
# Obtain these from developer.paypal.com -> Dashboard -> Apps & Credentials
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# LLM Provider Configuration (Groq API)
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_DRIFT_MODEL=llama-3.1-8b-instant
