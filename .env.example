# Database Configuration
POSTGRES_DB_USER=mandateguard
POSTGRES_DB_NAME=mandateguard
POSTGRES_DB_PASSWORD=your_postgres_password
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432

# PayPal Sandbox Developer Credentials
# Obtain these from developer.paypal.com -> Dashboard -> Apps & Credentials
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# LLM Provider Configuration (Groq API for NL Mandate Compilation)
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_DRIFT_MODEL=openai/gpt-oss-20b
